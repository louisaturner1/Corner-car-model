import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from scipy.integrate import solve_ivp
from scipy.interpolate import interp1d
import sys
sys.path.append("..")
from src.dynamics import quarter_car_ode, PARAMS
from src.filter import apply_lowpass_filter
from src.evaluate import compute_performance_metrics

# Plotting
plt.style.use('seaborn-v0_8-whitegrid' if 'seaborn-v0_8-whitegrid' in plt.style.available else 'default')
%matplotlib inline

# Road profile generation
distance = np.linspace(0, 50, 1000)
elevation = 0.05 * np.exp(-((distance - 10.0)**2) / 1.0)
road_interp = interp1d(distance, elevation, bounds_error=False, fill_value=0.0)

plt.figure(figsize=(10, 3))
plt.plot(distance, elevation * 100, color='black', linewidth=2)
plt.title("Input Road Profile Profile ($z_r$)")
plt.xlabel("Distance (m)")
plt.ylabel("Elevation (cm)")
plt.grid(True, linestyle=':')
plt.show()

# Solving the question for the quarter car simulation accross two speeds
def run_notebook_sim(v_car):
    params = PARAMS.copy()
    params['v_car'] = v_car
    t_max = distance[-1] / v_car
    t_eval = np.linspace(0, t_max, len(distance))
    
    sol = solve_ivp(
        fun=lambda t, y: quarter_car_ode(t, y, road_interp, params),
        t_span=(0, t_max),
        y0=[0.0, 0.0, 0.0, 0.0],
        t_eval=t_eval,
        method='RK45'
    )
    
    time = sol.t
    z_s, v_s, z_u, v_u = sol.y
    
    # Calculate sprung acceleration
    a_s = [(params['k_s']*(z_u[i]-z_s[i]) + params['c_s']*(v_u[i]-v_s[i])) / params['m_s'] for i in range(len(time))]
    
    return pd.DataFrame({
        'time_s': time,
        'sprung_disp_cm': z_s * 100,
        'sprung_accel_ms2': a_s
    })

df_low = run_notebook_sim(v_car=10.0)  
df_high = run_notebook_sim(v_car=20.0)  

# Comparative velocity response plot
fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(10, 7), sharex=False)

# Displacement
ax1.plot(df_low['time_s'], df_low['sprung_disp_cm'], label='36 km/h (10 m/s)', color='tab:blue')
ax1.plot(df_high['time_s'], df_high['sprung_disp_cm'], label='72 km/h (20 m/s)', color='tab:red')
ax1.set_ylabel("Chassis Displacement (cm)")
ax1.set_title("Sprung Mass Displacement Response")
ax1.legend()
ax1.grid(True, linestyle=':')

# Acceleration (Ride comfort)
ax2.plot(df_low['time_s'], df_low['sprung_accel_ms2'], label='36 km/h (10 m/s)', color='tab:blue')
ax2.plot(df_high['time_s'], df_high['sprung_accel_ms2'], label='72 km/h (20 m/s)', color='tab:red')
ax2.set_xlabel("Time (s)")
ax2.set_ylabel("Sprung Acceleration ($m/s^2$)")
ax2.set_title("Chassis Vertical Acceleration")
ax2.legend()
ax2.grid(True, linestyle=':')

plt.tight_layout()
plt.show()

# Demonstrating high-frequency noise attenuation via Butterworth low-pass filtering
# Add synthetic sensor noise to df high
np.random.seed(42)
noisy_accel = df_high['sprung_accel_ms2'] + np.random.normal(0, 0.3, len(df_high))
# Esitimating sample rate
fs = 1.0 / np.mean(np.diff(df_high['time_s']))
filtered_accel = apply_lowpass_filter(noisy_accel, cutoff_hz=15.0, fs=fs)

plt.figure(figsize=(10, 4))
plt.plot(df_high['time_s'], noisy_accel, label='Noisy Sensor Telemetry', alpha=0.5, color='gray')
plt.plot(df_high['time_s'], filtered_accel, label='Filtered Telemetry (15Hz Cutoff)', color='tab:green', linewidth=2)
plt.plot(df_high['time_s'], df_high['sprung_accel_ms2'], label='Ground Truth Analytical', color='black', linestyle='--')
plt.title("Zero-Phase Butterworth Filter Performance")
plt.xlabel("Time (s)")
plt.ylabel("Acceleration ($m/s^2$)")
plt.legend()
plt.grid(True, linestyle=':')
plt.show()
